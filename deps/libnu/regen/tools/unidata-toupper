#!/usr/bin/env python3

import sys
from unidata import *

if __name__ == '__main__':
	d: dict[str, list[str]] = dict()

	for line in sys.stdin:
		assert isinstance(line, str)

		if unidata_comment(line):
			continue

		tokens = line.split(';')
		codepoint, upper = tokens[0], tokens[12]

		if not upper:
			continue

		d[unidata_strip(codepoint)] = unidata_split(upper)

	for codepoint, replacement in sorted(d.items()):
		c = int(codepoint, base=16)
		replacement_str = ','.join(replacement)
		print(f'{c:06X} {replacement_str}')
