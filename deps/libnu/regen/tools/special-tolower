#!/usr/bin/env python3

import sys
from unidata import *

if __name__ == '__main__':
	d: dict[str, list[str]] = dict()

	for line in sys.stdin:
		assert isinstance(line, str)

		if unidata_comment(line):
			continue

		tokens = line.split(';')
		codepoint = unidata_strip(tokens[0])
		condition = unidata_strip(tokens[4])
		tolower, toupper = unidata_strip(tokens[1]), unidata_strip(tokens[3])

		if condition or not tolower or tolower == codepoint:  # only unconditional
			continue

		d[unidata_strip(codepoint)] = unidata_split(tolower)

	for codepoint, replacement in sorted(d.items()):
		c = int(codepoint, base=16)
		replacement_str = ','.join(replacement)
		print(f'{c:06X} {replacement_str}')
