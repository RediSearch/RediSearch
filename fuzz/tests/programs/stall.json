{
  "version": 1,
  "setup": {"module_args": ["WORKERS", "2"]},
  "ops": [
    {"op": "create", "index": "i1", "prefix": "doc:", "fields": [{"name": "t", "type": "text"}]},
    {"op": "write", "key": "doc:1", "fields": [["t", "hello"]]},
    {"op": "raw", "argv": ["_FT.DEBUG", "WORKERS", "PAUSE"]},
    {"op": "query", "index": "i1", "query": {"term": "hello"}}
  ]
}
