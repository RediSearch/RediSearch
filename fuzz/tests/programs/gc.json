{
  "version": 1,
  "ops": [
    {"op": "create", "index": "i1", "prefix": "doc:", "fields": [{"name": "t", "type": "text"}, {"name": "n", "type": "numeric"}, {"name": "g", "type": "tag"}]},
    {"op": "command", "argv": ["HSET", "doc:1", "t", "hello world", "n", "1", "g", "red"]},
    {"op": "command", "argv": ["HSET", "doc:2", "t", "hello there", "n", "2", "g", "blue"]},
    {"op": "command", "argv": ["DEL", "doc:1"]},
    {"op": "barrier"},
    {"op": "query", "index": "i1", "query": {"term": "hello"}, "options": {"no_content": true}}
  ]
