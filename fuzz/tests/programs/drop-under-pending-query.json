{
  "version": 1,
  "setup": {"module_args": ["WORKERS", "2"]},
  "ops": [
    {"op": "create", "index": "i1", "prefix": "doc:", "fields": [{"name": "t", "type": "text"}]},
    {"op": "write", "key": "doc:1", "fields": [["t", "hello"]]},
    {"op": "write", "key": "doc:2", "fields": [["t", "hello world"]]},
    {"op": "admin", "hook": "workers_pause"},
    {"conn": 1, "reply": "defer", "op": "query", "index": "i1", "query": {"term": "hello"}},
    {"op": "drop", "index": "i1", "delete_docs": true},
    {"op": "admin", "hook": "workers_resume"},
    {"op": "barrier"}
  ]
}
