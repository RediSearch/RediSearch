{
  "version": 1,
  "module_args": ["WORKERS", "2"],
  "ops": [
    {"op": "create", "index": "i1", "prefix": "doc:", "fields": [{"name": "t", "type": "text"}]},
    {"op": "command", "argv": ["HSET", "doc:1", "t", "hello"]},
    {"op": "command", "argv": ["_FT.DEBUG", "WORKERS", "PAUSE"]},
    {"conn": 1, "reply": "defer", "op": "query", "index": "i1", "query": {"term": "hello"}},
    {"op": "command", "argv": ["FT.DROPINDEX", "i1", "DD"]},
    {"op": "command", "argv": ["_FT.DEBUG", "WORKERS", "RESUME"]},
    {"op": "barrier"}
  ]
}
