{
  "version": 1,
  "module_args": ["ON_TIMEOUT", "FAIL"],
  "ops": [
    {"op": "create", "index": "i0", "prefix": "d0:", "fields": [
      {"name": "f0", "type": "text"},
      {"name": "f1", "type": "numeric"},
      {"name": "f2", "type": "tag"}
    ]},
    {"op": "populate", "prefix": "d0:", "fields": [
      {"name": "f0", "type": "text"},
      {"name": "f1", "type": "numeric"},
      {"name": "f2", "type": "tag"}
    ], "n": 300, "seed": 5},
    {"op": "create", "index": "i1", "prefix": "d0:", "fields": [
      {"name": "f2", "type": "tag", "sortable": true},
      {"name": "f0", "type": "text", "sortable": true},
      {"name": "f1", "type": "numeric", "sortable": true}
    ]},
    {"op": "barrier"},
    {"op": "query", "index": "i0", "query": {"term": "hello"}, "options": {"no_content": true, "limit": [0, 1000]}},
    {"op": "query", "index": "i0", "query": {"and": [{"term": "hello"}, {"tag": {"field": "f2", "values": ["red"]}}]}, "options": {"no_content": true, "limit": [0, 1000]}},
    {"op": "query", "index": "i0", "query": {"and": [{"term": "hello"}, {"not": {"tag": {"field": "f2", "values": ["red"]}}}]}, "options": {"no_content": true, "limit": [0, 1000]}},
    {"op": "query", "index": "i0", "query": {"range": {"field": "f1", "min": {"inclusive": 0}, "max": {"exclusive": 5000}}}, "options": {"no_content": true, "limit": [0, 1000]}},
    {"op": "query", "index": "i0", "query": {"not": {"range": {"field": "f1", "min": {"inclusive": 0}, "max": {"exclusive": 5000}}}}, "options": {"no_content": true, "limit": [0, 1000]}},
    {"op": "query", "index": "i0", "query": "all", "options": {"no_content": true, "limit": [0, 1000]}},
    {"op": "command", "argv": ["_FT.DEBUG", "GC_FORCEINVOKE", "i0"]},
    {"op": "query", "index": "i0", "query": {"term": "hello"}, "options": {"no_content": true, "limit": [0, 1000]}},
    {"op": "query", "index": "i1", "query": {"term": "hello"}, "options": {"no_content": true, "limit": [0, 1000]}},
    {"op": "command", "argv": ["DEBUG", "RELOAD"]},
    {"op": "barrier"},
    {"op": "query", "index": "i0", "query": {"term": "hello"}, "options": {"no_content": true, "limit": [0, 1000]}},
    {"op": "query", "index": "i1", "query": {"term": "hello"}, "options": {"no_content": true, "limit": [0, 1000]}}
  ]
}
