          }
        ]
      }
    },
    {
      "op": {
        "op": "command",
        "argv": [
          "_FT.DEBUG",
          "WORKERS",
          "PAUSE"
        ]
      }
    },
    {
      "op": {
        "conn": 1,
        "defer": true,
        "op": "query",
        "index": "i1",
        "query": "all"
      }
    },
    {
      "op": {
        "conn": 1,
        "op": "command",
        "argv": [
          "PING"
        ]
      }
    }
  ]
