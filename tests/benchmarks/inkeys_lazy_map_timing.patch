--- a/src/indexes_scan.c
+++ b/src/indexes_scan.c
@@ -84,6 +84,8 @@
 
 typedef struct {
   WeakRef spec;
+  struct timespec started;
+  uint64_t max_hold_ns, total_hold_ns, batches;
 } KeyMapBuild;
 
 static void KeyMapBuild_Run(void *arg) {
@@ -96,8 +98,19 @@
   bool done = true;
   if (spec) {
     IndexSpec_LockWrite(spec);
+    struct timespec begin, end;
+    clock_gettime(CLOCK_MONOTONIC, &begin);
     done = DocTable_BuildKeyMapBatch(&spec->docs, 1024);
+    clock_gettime(CLOCK_MONOTONIC, &end);
+    uint64_t ns = (end.tv_sec - begin.tv_sec) * 1000000000LL + end.tv_nsec - begin.tv_nsec;
+    build->max_hold_ns = MAX(build->max_hold_ns, ns);
+    build->total_hold_ns += ns;
+    build->batches++;
     IndexSpec_Unlock(spec);
+    if (done) {
+      uint64_t elapsed = (end.tv_sec - build->started.tv_sec) * 1000000000LL + end.tv_nsec - build->started.tv_nsec;
+      fprintf(stderr, "KEYMAP_BENCH elapsed_ns=%lu max_hold_ns=%lu total_hold_ns=%lu batches=%lu\n", elapsed, build->max_hold_ns, build->total_hold_ns, build->batches);
+    }
 #ifdef ENABLE_ASSERT
     if (done) SyncPoint_Wait("KeyMapBuildComplete");
 #endif
@@ -125,7 +138,8 @@
     reindexPool =
         redisearch_thpool_create(1, DEFAULT_HIGH_PRIORITY_BIAS_THRESHOLD, LogCallback, "reindex");
   }
-  KeyMapBuild *build = rm_malloc(sizeof(*build));
+  KeyMapBuild *build = rm_calloc(1, sizeof(*build));
+  clock_gettime(CLOCK_MONOTONIC, &build->started);
   build->spec = StrongRef_Demote(IndexSpec_GetStrongRefUnsafe(spec));
   int rc = redisearch_thpool_add_work(reindexPool, KeyMapBuild_Run, build, THPOOL_PRIORITY_LOW);
   RS_ASSERT_ALWAYS(rc == 0);
